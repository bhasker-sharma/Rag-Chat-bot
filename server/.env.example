# Copy this file to ".env" and fill in your real key.
# .env is never committed to git; .env.example is just a template.

OPENAI_API_KEY=sk-...

# Model names - check https://platform.openai.com/docs/models for current ones
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
